BEGIN:VCALENDAR
PRODID:-//Watcher Dashboard//Sample Calendar//EN
VERSION:2.0
METHOD:PUBLISH
X-WR-CALNAME:Sample Work Calendar
BEGIN:VTIMEZONE
TZID:Central Standard Time
BEGIN:STANDARD
DTSTART:16011104T020000
RRULE:FREQ=YEARLY;BYDAY=1SU;BYMONTH=11
TZOFFSETFROM:-0500
TZOFFSETTO:-0600
END:STANDARD
BEGIN:DAYLIGHT
DTSTART:16010311T020000
RRULE:FREQ=YEARLY;BYDAY=2SU;BYMONTH=3
TZOFFSETFROM:-0600
TZOFFSETTO:-0500
END:DAYLIGHT
END:VTIMEZONE
BEGIN:VEVENT
UID:weekly-standup@sample
DTSTART;TZID=Central Standard Time:20250106T090000
DTEND;TZID=Central Standard Time:20250106T093000
RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR
EXDATE;TZID=Central Standard Time:20261002T090000
SUMMARY:Team stand-up
LOCATION:Teams
END:VEVENT
BEGIN:VEVENT
UID:daily-lunch@sample
DTSTART;TZID=Central Standard Time:20250106T120000
DTEND;TZID=Central Standard Time:20250106T130000
RRULE:FREQ=DAILY
SUMMARY:Lunch
END:VEVENT
BEGIN:VEVENT
UID:monthly-review@sample
DTSTART;TZID=Central Standard Time:20250107T140000
DTEND;TZID=Central Standard Time:20250107T150000
RRULE:FREQ=WEEKLY;BYDAY=TU
SUMMARY:Project review with Dana
LOCATION:Conference Room B
END:VEVENT
BEGIN:VEVENT
UID:allday-payroll@sample
DTSTART;VALUE=DATE:20250101
DTEND;VALUE=DATE:20250102
RRULE:FREQ=WEEKLY;BYDAY=TH
SUMMARY:Payroll due
END:VEVENT
BEGIN:VEVENT
UID:cancelled-one@sample
DTSTART;TZID=Central Standard Time:20250108T160000
DTEND;TZID=Central Standard Time:20250108T170000
RRULE:FREQ=DAILY
STATUS:CANCELLED
SUMMARY:Cancelled meeting (should never appear)
END:VEVENT
BEGIN:VEVENT
UID:evening-utc@sample
DTSTART:20250106T230000Z
DTEND:20250107T000000Z
RRULE:FREQ=WEEKLY;BYDAY=MO
SUMMARY:Evening call (stored in UTC)
END:VEVENT
END:VCALENDAR
