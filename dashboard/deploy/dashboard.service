[Unit]
Description=Watcher Dashboard (weather, radar, stocks, calendar, photos, news)
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=-__DIR__/.env
ExecStart=__DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
