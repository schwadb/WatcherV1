# Copy this file to .env and fill in the values. Never commit .env.

# Free key from https://finnhub.io/register (shown on your Finnhub dashboard)
FINNHUB_API_KEY=

# Outlook on the web -> Settings -> Calendar -> Shared calendars -> Publish a calendar
# -> "Can view all details" -> Publish -> copy the ICS link (not the HTML one)
OUTLOOK_ICS_URL=

# More calendars: add a line per link and reference it from config.yaml as "${FAMILY_ICS_URL}"
# FAMILY_ICS_URL=

# Optional PIN that the phone settings page asks for (leave empty for none)
DASHBOARD_PIN=

# Spotify "now playing" (see README): the Client ID of your Spotify developer app
SPOTIFY_CLIENT_ID=

# Set to 1 to run with sample data and no internet (useful for testing)
DASHBOARD_MOCK=0
