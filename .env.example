# Copy this file to .env and fill in MCP_API_KEY before deploying.

# REQUIRED — the shared secret every AI client presents.
# Generate one with:  openssl rand -hex 32
MCP_API_KEY=

# Pinned server version. Bump deliberately: read the release notes at
# https://codeberg.org/doobidoo/mcp-memory-service/releases, run a backup,
# change the tag, redeploy, re-run scripts/smoke-test.sh.
MEMORY_IMAGE_TAG=11.4.0-slim

# Host port the server is reachable on.
MEMORY_PORT=8000

# Which NAS address to listen on. 0.0.0.0 = all interfaces (home LAN and
# tailnet). For strictly tailnet-only, set this to the NAS Tailscale IP
# (the 100.x.y.z address).
MEMORY_BIND_IP=0.0.0.0

# Data locations on the NAS. Relative paths resolve next to this file;
# absolute paths (e.g. /volume1/docker/watcher-memory/data) also work.
DATA_DIR=./data
BACKUPS_DIR=./backups
MODEL_CACHE_DIR=./model-cache

# Server-side automatic backups (written into BACKUPS_DIR).
MCP_BACKUP_ENABLED=true
MCP_BACKUP_INTERVAL=daily
MCP_BACKUP_RETENTION=7
MCP_BACKUP_MAX_COUNT=10

LOG_LEVEL=INFO
